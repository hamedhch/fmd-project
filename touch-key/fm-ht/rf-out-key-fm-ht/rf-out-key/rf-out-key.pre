void POWER_INITIAL(void);
void TIMER2_INITIAL(void);
void TIMER0_INITIAL(void);
unsigned char EEPROMread(unsigned char EEAddr);
void EEPROMwrite(unsigned char EEAddr, unsigned char Data);
void DelayUs(unsigned char Time);
void DelayMs(unsigned int Time);
void Check_RF_Match(void);
void Learn_Current_Remote(unsigned char key_num);
void Process_Touch_Payload(void);
void Clear_Key_Remotes(unsigned char key_num);




void interrupt ISR(void)
{

if(T0IE && T0IF)
{
TMR0 = 239;
T0IF = 0;

if(LernRF == 1)
{
conternotRF++;
if(conternotRF >= 15000)
{
conternotRF = 0;
LernRF = 0;
LernRFKey = 0;
}
}


if(PA2 == 0)
{
high_counter = 0;
if(pulse_counter < 250) pulse_counter++;

if(rx_state == 1)
{
rx_state = 2;
pulse_counter = 1;
}
}
else
{
if(high_counter < 250) high_counter++;

if(rx_state == 0)
{
if(pulse_counter >= 20 && pulse_counter <= 30)
{
rx_state = 1;
}
pulse_counter = 0;
}
else if(rx_state == 1)
{
if(high_counter > 80)
{
rx_state = 0;
pulse_counter = 0;
}
}
else if(rx_state == 2)
{
payload_val = pulse_counter;
rx_state = 3;
pulse_counter = 0;
high_counter = 1;
}
else if(rx_state == 3)
{
if(high_counter >= 15)
{
frame_ready = 1;
rx_state = 0;
}
}
}


if(RxBusy == 1 && PA2 == 1 && high_counter >= 60)
{
RxBusy = 0;
}
}



if(TMR2IE && TMR2IF)
{
TMR2IF = 0;
asm("clrwdt");

if(PA3 == 0)
{
if(Timedown < 250)
{
Timedown++;
}
Frist = 1;
}
else
{

if(Timedown >= 250)
{
Timedown = 0;
Frist = 0;
Start = 0;
Bit = 8;
Buffer = 0;
Count = 0;
Finish = 0;
return;
}


if((Frist == 1) && (Finish == 0))
{

if(Timedown >= 180 && Timedown <= 245)
{
Start = 1;
Bit = 8;
Count = 0;
Buffer = 0;
}

else if(Start == 1)
{
Bit--;


if(Timedown >= 14 && Timedown <= 32)
{
Buffer = Buffer << 1;
}

else if(Timedown >= 4 && Timedown <= 13)
{
Buffer = (Buffer << 1) | 1;
}

else
{
Count = 0;
Bit = 8;
Buffer = 0;
Start = 0;
}


if(Bit == 0)
{
Bit = 8;
Data[Count] = RFData[Count];
RFData[Count] = Buffer;
Count++;


if(Count >= 3)
{
Count = 0;
Start = 0;


if(Data[0] == RFData[0] &&
Data[1] == RFData[1] &&
Data[2] == RFData[2])
{
DataM[0] = RFData[0];
DataM[1] = RFData[1];
DataM[2] = RFData[2];
Finish = 1;
Lock = 1;
}
}
Buffer = 0;
}
}

Frist = 0;
}

Timedown = 0;
}
}


}

# 267
void Clear_Key_Remotes(unsigned char key_num)
{
unsigned char i;
unsigned char addr;

# 277
addr = (key_num - 1) * 15;

for(i = 0; i < 15; i++)
{
EEPROMwrite(addr++, 0xFF);
}


EEPROMwrite(59 + key_num, 0);
}




void Check_RF_Match(void)
{
unsigned char k, r, base_addr;

for(k = 0; k < 4; k++)
{
for(r = 0; r < 5; r++)
{
base_addr = (k * 5 * 3) + (r * 3);

if(DataM[0] == EEPROMread(base_addr) &&
DataM[1] == EEPROMread(base_addr + 1) &&
DataM[2] == EEPROMread(base_addr + 2))
{
if(k == 0) O1 = 1;
else if(k == 1) O2 = 1;
else if(k == 2) O3 = 1;
else if(k == 3) O4 = 1;

}
}
}
}




void Learn_Current_Remote(unsigned char key_num)
{
unsigned char r;
unsigned char k_idx;
unsigned char base_addr;
unsigned char fifo_ptr_addr;
unsigned char current_ptr;
unsigned char target_addr;

if((key_num < 1) || (key_num > 4))
return;

k_idx = key_num - 1;


for(r = 0; r < 5; r++)
{
base_addr = (k_idx * 5 * 3) + (r * 3);

if((DataM[0] == EEPROMread(base_addr)) &&
(DataM[1] == EEPROMread(base_addr + 1)) &&
(DataM[2] == EEPROMread(base_addr + 2)))
{
return;
}
}


fifo_ptr_addr = 60 + k_idx;
current_ptr = EEPROMread(fifo_ptr_addr);

if(current_ptr >= 5)
current_ptr = 0;

target_addr = (k_idx * 5 * 3) + (current_ptr * 3);


EEPROMwrite(target_addr, DataM[0]);
EEPROMwrite(target_addr + 1, DataM[1]);
EEPROMwrite(target_addr + 2, DataM[2]);


current_ptr++;
if(current_ptr >= 5)
current_ptr = 0;

EEPROMwrite(fifo_ptr_addr, current_ptr);

# 399
if(key_num == 1) O1 = 1;
else if(key_num == 2) O2 = 1;
else if(key_num == 3) O3 = 1;
else O4 = 1;

# 408
lastLearnKey = 0;

LernRFKey = 0;
LernRF = 0;
}




void Process_Touch_Payload(void)
{
unsigned char val = payload_val;
payload_val = 0;

if(RxBusy == 1) return;
RxBusy = 1;


if(val >= 120 && val <= 140)
{
if((lastKey >= 1) && (lastKey <= 4))
{


if(lastLearnKey == lastKey)
{
Clear_Key_Remotes(lastKey);


LernRF = 0;
LernRFKey = 0;


lastLearnKey = 5;


LernRFblink = 1;
}
else
{

lastLearnKey = lastKey;
LernRFblink = 1;
}
}
}

else if(val >= 10 && val <= 20 && LernRFKey != 1)
{
state1 = !state1;
eerom = 1;
PA5 = state1;
lastKey = 1;
}

else if(val >= 30 && val <= 45 && LernRFKey != 2)
{
state2 = !state2;
eerom = 2;
PA1 = state2;
lastKey = 2;
}

else if(val >= 50 && val <= 70 && LernRFKey != 3)
{
state3 = !state3;
eerom = 3;
PA0 = state3;
lastKey = 3;
}

else if(val >= 75 && val <= 95 && LernRFKey != 4)
{
state4 = !state4;
eerom = 4;
PA4 = state4;
lastKey = 4;
}
}




void main(void)
{

POWER_INITIAL();
TIMER2_INITIAL();
TIMER0_INITIAL();
TMR2IE = 1;

Finish = 0;
Start = 0;
lastLearnKey = 0;


state1 = EEPROMread(70);
state2 = EEPROMread(71);
state3 = EEPROMread(72);
state4 = EEPROMread(73);

PA5 = state1;
PA1 = state2;
PA0 = state3;
PA4 = state4;

while(1)
{
asm("clrwdt");


if(frame_ready == 1)
{
frame_ready = 0;
Process_Touch_Payload();
}



if(Lock == 1)
{
Lock = 0;

if(LernRF == 1)
{
if((LernRFKey >= 1) && (LernRFKey <= 4))
{
Learn_Current_Remote(LernRFKey);
}
}
else
{
Check_RF_Match();
}
}




if(O1 == 1) { O1 = 0; state1 = !state1; eerom = 1; PA5 = state1; lastKey = 1; }
if(O2 == 1) { O2 = 0; state2 = !state2; eerom = 2; PA1 = state2; lastKey = 2; }
if(O3 == 1) { O3 = 0; state3 = !state3; eerom = 3; PA0 = state3; lastKey = 3; }
if(O4 == 1) { O4 = 0; state4 = !state4; eerom = 4; PA4 = state4; lastKey = 4; }


if(eerom != 0)
{
if(eerom == 1) EEPROMwrite(70, state1);
else if(eerom == 2) EEPROMwrite(71, state2);
else if(eerom == 3) EEPROMwrite(72, state3);
else if(eerom == 4) EEPROMwrite(73, state4);
eerom = 0;
}


if(LernRFblink == 1)
{

if(lastKey == 1)
{
DelayMs(200);
PA5 = !PA5;
DelayMs(200);
PA5 = !PA5;
}
else if(lastKey == 2)
{
DelayMs(200);
PA1 = !PA1;
DelayMs(200);
PA1 = !PA1;
}
else if(lastKey == 3)
{
DelayMs(200);
PA0 = !PA0;
DelayMs(200);
PA0 = !PA0;
}
else if(lastKey == 4)
{
DelayMs(200);
PA4 = !PA4;
DelayMs(200);
PA4 = !PA4;
}

LernRFblink = 0;
conternotRF = 0;



if(lastLearnKey == 5)
{
lastLearnKey = 0;
LernRFblink = 1;
LernRFKey = 0;
LernRF = 0;
}
else if(lastLearnKey != 0)
{

LernRFKey = lastLearnKey;
LernRF = 1;
}
else
{

LernRFKey = 0;
LernRF = 0;
}
}

}
}

# 628
void POWER_INITIAL(void)
{
OSCCON = 0B01110000;
INTCON = 0;
OPTION = 0B00001000;
PORTA = 0B00000100;
TRISA = 0B00001100;
WPUA = 0B00001100;
MSCKCON = 0B00000000;
}

void TIMER2_INITIAL(void)
{
T2CON = 0B00000001;
TMR2 = 0;
PR2 = 50;
TMR2IF = 0;
TMR2ON = 1;
PEIE = 1;
GIE = 1;
}

void TIMER0_INITIAL(void)
{
OPTION = 0B00000110;
TMR0 = 239;
T0IF = 0;
T0IE = 1;
}

unsigned char EEPROMread(unsigned char EEAddr)
{
EEADR = EEAddr;
RD = 1;
return EEDAT;
}

void EEPROMwrite(unsigned char EEAddr, unsigned char Data)
{
GIE = 0;
while(GIE);
EEADR = EEAddr;
EEDAT = Data;
EEIF = 0;
EECON1 |= 0x34;
WR = 1;
while(WR);
GIE = 1;
}

void DelayUs(unsigned char Time)
{
unsigned char a;
for(a = 0; a < Time; a++)
{
__nop();
asm("clrwdt");
}
}

void DelayMs(unsigned int Time)
{
unsigned int a, b;
for(a = 0; a < Time; a++)
{
for(b = 0; b < 5; b++)
{
DelayUs(197);
}
}
}
